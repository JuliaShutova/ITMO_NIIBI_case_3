manifest {
    name = 'rare-disease-nextflow'
    description = 'Research pipeline for rare-disease variant prioritization'
    mainScript = 'main.nf'
}

params {
    input_dir = 'inputdata'
    metadata = "${params.input_dir}/metadata.json"
    phenotype = "${params.input_dir}/phenotype.json"
    variants = "${params.input_dir}/variants.vcf"

    outdir = 'results'
    assembly = 'GRCh38'
    reference_fasta = "${projectDir}/data/reference/hg38.fa"
    skip_ref_check = false

    // Annotation is opt-in until local databases and exact versions are configured.
    enable_snpeff = true
    snpeff_db = 'GRCh38.99'
    snpeff_config = '/home/nilmbb/asenko/miniconda3/envs/rare-disease-nf/share/snpeff-5.2-3/snpEff.config'
    clinvar_db = '/home/nilmbb/asenko/rare-disease-nextflow/clinvar.vcf.gz'

    enable_annotsv = false
    annotsv_script = ''
    annotsv_db = ''

    enable_phen2gene = true
    phen2gene_script = '/home/nilmbb/asenko/miniconda3/bin/conda run -n phen2gene python /home/nilmbb/asenko/rare-disease-nextflow/Phen2Gene/phen2gene.py'
    phen2gene_data = ''

    enable_lirical = false
    lirical_jar = ''
    exomiser_data = ''

    // Optional local annotation VCFs. If configured, add an explicit bcftools
    // annotation stage in a deployment-specific extension; never infer missing=benign.
    clinvar_vcf = ''
    gnomad_vcf = ''
    gene_disease_tsv = ''

    // Rule-based scoring is the default. ML training is deliberately not enabled
    // on the tiny development benchmark.
    enable_ml = false
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    cpus = 2
    memory = '4 GB'
    time = '2h'
    withName: ANNOTATE_SNPEFF {
        cpus = 4
        memory = '8 GB'
        time = '8h'
    }
    withName: ANNOTATE_SV {
        cpus = 4
        memory = '8 GB'
        time = '8h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    docker {
        docker.enabled = true
        process.container = 'continuumio/miniconda3:24.7.1-0'
    }
    test {
        params.enable_snpeff = false
        params.enable_annotsv = false
        params.enable_phen2gene = false
        params.enable_lirical = false
        process.executor = 'local'
    }
}
